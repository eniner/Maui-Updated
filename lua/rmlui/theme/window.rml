<template name="window" content="window-content">
<head>
	<link type="text/rcss" href="window.rcss"/>
</head>
<body class="theme-azure">
	<div id="window-shadow"></div>
	<div id="window-frame">
		<div id="window-titlebar" drag="1">
			<div id="window-icon"></div>
			<div id="window-title">Window</div>
			<div class="window-spacer"></div>
			<div id="window-pin" class="window-button" action="window:pin" title="Pin">&#xE718;</div>
			<div id="window-collapse" class="window-button" action="window:collapse" title="Collapse">&#xE70E;</div>
			<div id="window-close" class="window-button close" action="window:close" title="Close">&#xE8BB;</div>
		</div>
		<div id="window-accent"></div>
		<div id="window-content"></div>
		<div id="window-grip" resize="1"></div>
	</div>
</body>
</template>
