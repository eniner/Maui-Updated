/* GM Console — RmlUi */

#window-content {
	display: flex;
	flex-direction: column;
	gap: 0;
	overflow: hidden;
	padding: 0;
	position: relative;
}

.ico { font-family: Icons; }
.spacer { flex: 1; }
.muted { color: #7f889d; font-size: 11.5dp; }
.hint { color: #646d82; font-size: 11dp; }

/* status */
.statusbar {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	padding: 10dp 14dp;
	background-color: #00000040;
	border-bottom: 1dp #ffffff10;
}
.live-dot {
	width: 8dp; height: 8dp;
	border-radius: 4dp;
	background-color: #2fcf95;
	animation: 1.6s sine-in-out infinite alternate breathe;
}
@keyframes breathe {
	from { opacity: 1; }
	to   { opacity: 0.35; }
}
.player { font-weight: bold; color: #e7eaf3; }
.zone { color: #9aa3b8; }
.sep { color: #4a5163; }
.badge {
	padding: 2dp 10dp;
	border-radius: 8dp;
	font-size: 11dp;
	font-weight: bold;
	color: #d7c4ff;
	background-color: #9b6bff33;
	border: 1dp #9b6bff55;
}

/* body split */
.body {
	flex: 1 1 auto;
	display: flex;
	flex-direction: row;
	min-height: 0;
	overflow: hidden;
}

.sidebar {
	flex: 0 0 230dp;
	display: flex;
	flex-direction: column;
	border-right: 1dp #ffffff10;
	background-color: #00000022;
}
.side-head {
	padding: 10dp 12dp 6dp 12dp;
	font-size: 10.5dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #7f889d;
}
.nav { flex: 1 1 auto; overflow-y: auto; padding: 4dp 6dp 10dp 6dp; }

.nav-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 8dp 10dp;
	margin: 1dp 0;
	border-radius: 8dp;
	border-left: 3dp #00000000;
	transition: background-color border-color 0.15s cubic-out;
}
.nav-item:hover { background-color: #ffffff0c; }
.nav-item.on {
	background-color: #4c8dff22;
	border-left-color: #4c8dff;
}
.nav-item.cat-Lead.on { background-color: #e5484d22; border-left-color: #e5484d; }
.nav-item.cat-NPC.on { background-color: #ffb02e22; border-left-color: #ffb02e; }
.nav-item.cat-Zone.on { background-color: #2fcf9522; border-left-color: #2fcf95; }
.nav-item.cat-Player.on { background-color: #9b6bff22; border-left-color: #9b6bff; }
.nav-item.cat-ZC.on { background-color: #47c8f022; border-left-color: #47c8f0; }
.nav-item.cat-Flags.on { background-color: #ff5c8a22; border-left-color: #ff5c8a; }
.nav-ico {
	width: 22dp;
	height: 18dp;
	line-height: 18dp;
	border-radius: 5dp;
	text-align: center;
	font-size: 9dp;
	font-weight: bold;
	letter-spacing: 0.4dp;
	color: #c9d1e3;
	background-color: #ffffff14;
}
.nav-item.cat-Basic .nav-ico { color: #8fb4ff; background-color: #4c8dff26; }
.nav-item.cat-NPC .nav-ico { color: #ffd166; background-color: #ffb02e26; }
.nav-item.cat-Lead .nav-ico { color: #ff8a7a; background-color: #e5484d26; }
.nav-item.cat-Zone .nav-ico { color: #5fe0b0; background-color: #2fcf9526; }
.nav-item.cat-Player .nav-ico { color: #c4b0ff; background-color: #9b6bff26; }
.nav-item.cat-ZC .nav-ico { color: #7fd8ff; background-color: #47c8f026; }
.nav-item.cat-Flags .nav-ico { color: #ff85a6; background-color: #ff5c8a26; }
.nav-item.on .nav-ico { color: #ffffff; }

.nav-label { flex: 1; color: #c9d1e3; font-size: 12dp; white-space: nowrap; overflow: hidden; }
.nav-item.on .nav-label { color: #ffffff; font-weight: bold; }
.nav-n {
	padding: 0 6dp;
	border-radius: 7dp;
	font-size: 10dp;
	font-weight: bold;
	color: #8d97ad;
	background-color: #ffffff10;
}

.main {
	flex: 1 1 auto;
	display: flex;
	flex-direction: column;
	min-width: 0;
	overflow: hidden;
	padding: 10dp 12dp 8dp 12dp;
}
.main-head {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	margin-bottom: 8dp;
}
.accent {
	width: 3dp; height: 18dp;
	border-radius: 2dp;
	background-color: #4c8dff;
}
.sec-title { font-size: 14dp; font-weight: bold; color: #ffffff; white-space: nowrap; overflow: hidden; }

.cmd-grid {
	flex: 1 1 auto;
	overflow-y: auto;
	display: block;
	padding: 4dp;
}
.empty {
	display: none;
	flex: 1 1 auto;
	padding-top: 40dp;
	text-align: center;
	color: #8d97ad;
}
.main.is-empty .cmd-grid { display: none; }
.main.is-empty .empty { display: block; }

.cmd {
	display: inline-block;
	margin: 0 6dp 6dp 0;
	padding: 8dp 14dp;
	min-width: 118dp;
	border-radius: 8dp;
	font-size: 12dp;
	font-weight: bold;
	text-align: center;
	color: #d3d9e8;
	background-color: #ffffff0e;
	border: 1dp #ffffff14;
	border-left: 3dp #4c8dff88;
	transition: background-color color border-color 0.12s cubic-out;
	white-space: nowrap;
}
.cmd:hover { background-color: #ffffff1c; color: #ffffff; }
.cmd:active { background-color: #ffffff28; }
.cmd.need { border-left-color: #47c8f0; }
.cmd.danger {
	border-left-color: #e5484d;
	color: #ffb4a8;
}
.cmd.danger:hover { background-color: #e5484d33; color: #ffffff; }
.cmd.say { border-left-color: #9b6bff; }
.cmd.exact {
	border-color: #ffd16688;
	decorator: vertical-gradient(#ffb02e33 #ffb02e11);
}

/* dock */
.dock {
	flex: 0 0 auto;
	padding: 10dp 12dp 12dp 12dp;
	border-top: 1dp #ffffff12;
	background-color: #00000033;
	display: flex;
	flex-direction: column;
	gap: 8dp;
}
.dock-row { display: flex; flex-direction: row; align-items: flex-end; gap: 8dp; }
.dock-foot { display: flex; flex-direction: row; align-items: center; gap: 8dp; }
.field { display: flex; flex-direction: column; gap: 3dp; }
.field.grow { flex: 1; }
.field-lbl {
	font-size: 10dp;
	font-weight: bold;
	letter-spacing: 0.8dp;
	text-transform: uppercase;
	color: #7f889d;
}
.field input.text {
	width: 100%;
	height: 22dp;
	line-height: 22dp;
	padding: 4dp 9dp;
	border-radius: 8dp;
	color: #f2f4fa;
	background-color: #00000050;
	border: 1dp #ffffff1a;
}
.field input.text:focus { border-color: #4c8dffaa; background-color: #4c8dff12; }
.last { color: #8fd3ff; font-size: 11.5dp; white-space: nowrap; overflow: hidden; }

.btn {
	padding: 7dp 14dp;
	border-radius: 8dp;
	font-size: 12dp;
	font-weight: bold;
	color: #d3d9e8;
	background-color: #ffffff12;
	border: 1dp #ffffff18;
	transition: background-color color 0.12s cubic-out;
}
.btn:hover { background-color: #ffffff22; color: #ffffff; }
.btn.primary { color: #ffffff; background-color: #3d74e0; border-color: #6fa3ff66; }
.btn.primary:hover { background-color: #4c8dff; }
.btn.danger { color: #ffffff; background-color: #d94444; border-color: #ff8a7a66; }
.btn.danger:hover { background-color: #e5484d; }

/* confirm modal */
.modal {
	display: none;
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: vertical-gradient(#0b0d14cc #0b0d14e8);
}
.modal.show {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	animation: 0.2s cubic-out rise;
}
@keyframes rise {
	from { opacity: 0; }
	to   { opacity: 1; }
}
.modal-card {
	width: 420dp;
	padding: 16dp;
	border-radius: 12dp;
	border: 1dp #e5484d55;
	decorator: vertical-gradient(#2a1520f5 #141018f8);
	display: flex;
	flex-direction: column;
	gap: 10dp;
}
.modal-title {
	font-size: 15dp;
	font-weight: bold;
	color: #ffb4a8;
}
.modal-title .ico { font-size: 14dp; }
.modal-cmd {
	padding: 10dp 12dp;
	border-radius: 8dp;
	font-size: 12.5dp;
	color: #e7eaf3;
	background-color: #00000055;
	border: 1dp #ffffff14;
}
.modal-actions { display: flex; flex-direction: row; gap: 8dp; }
