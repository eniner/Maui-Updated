/* God Tier / God Talents — RmlUi */

#window-content {
	display: flex;
	flex-direction: column;
	gap: 10dp;
	overflow: hidden;
	padding: 14dp 14dp 12dp 14dp;
}

.ico { font-family: Icons; }
.spacer { flex: 1; }
.muted { color: #8d97ad; font-size: 11.5dp; }

/* hero */
.hero {
	display: flex;
	flex-direction: row;
	gap: 10dp;
	flex: 0 0 auto;
}
.hero.compact .hero-title { font-size: 18dp; }
.hero-main {
	flex: 1.8;
	padding: 12dp 14dp;
	border-radius: 12dp;
	border: 1dp #9b6bff33;
	decorator: horizontal-gradient(#7a4fe044 #47c8f014);
	animation: 0.4s cubic-out rise;
}
.eyebrow {
	font-size: 10dp;
	font-weight: bold;
	letter-spacing: 1.2dp;
	color: #c4b0ff;
	text-transform: uppercase;
}
.hero-title {
	font-size: 22dp;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
}
.hero-sub { margin-top: 2dp; color: #b8c0d4; font-size: 12.5dp; }

.stat {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	padding: 10dp 12dp;
	border-radius: 12dp;
	background-color: #ffffff07;
	border: 1dp #ffffff0f;
	animation: 0.5s cubic-out rise;
}
@keyframes rise {
	from { opacity: 0; transform: translateY(8dp); }
	to   { opacity: 1; transform: translateY(0dp); }
}
.stat-ico {
	width: 34dp; height: 34dp; line-height: 34dp;
	border-radius: 10dp;
	text-align: center;
	font-family: Icons;
	font-size: 14dp;
}
.stat-ico.lvl  { color: #ffd166; decorator: vertical-gradient(#ffb02e40 #ffb02e14); }
.stat-ico.zone { color: #8fb4ff; decorator: vertical-gradient(#4c8dff40 #4c8dff14); }
.stat-ico.done { color: #5fe0b0; decorator: vertical-gradient(#2fcf9540 #2fcf9514); }
.stat-num { font-size: 18dp; font-weight: bold; color: #ffffff; line-height: 20dp; }
.stat-num.small { font-size: 12dp; line-height: 20dp; white-space: nowrap; overflow: hidden; }
.stat-lbl { font-size: 10.5dp; color: #8d97ad; }

/* banners */
.banner {
	display: none;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 8dp 12dp;
	border-radius: 10dp;
	font-size: 12dp;
	font-weight: bold;
	flex: 0 0 auto;
}
.banner.show { display: flex; animation: 0.35s cubic-out rise; }
.banner.warn { color: #ffb4a8; background-color: #e5484d1a; border: 1dp #e5484d44; }
.banner.info { color: #8fd3ff; background-color: #47c8f01a; border: 1dp #47c8f044; }
.banner .ico { font-size: 13dp; }

/* sections */
.section-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	flex: 0 0 auto;
	font-size: 11dp;
	font-weight: bold;
	letter-spacing: 0.8dp;
	text-transform: uppercase;
	color: #b896ff;
}
.section-head .ico { font-size: 12dp; }

.card-grid {
	flex: 0 0 auto;
	display: flex;
	flex-direction: column;
	gap: 4dp;
	max-height: 168dp;
	overflow-y: auto;
	padding: 4dp;
	border-radius: 12dp;
	background-color: #00000026;
	border: 1dp #ffffff10;
}

.item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	padding: 7dp 10dp;
	border-radius: 8dp;
	border-left: 3dp #ffffff18;
	transition: background-color border-color 0.18s cubic-out;
}
.item:hover { background-color: #ffffff0a; }
.item.have {
	border-left-color: #2fcf95;
	decorator: horizontal-gradient(#2fcf9514 #2fcf9500);
}
.item-qty {
	min-width: 42dp;
	padding: 2dp 8dp;
	border-radius: 7dp;
	text-align: center;
	font-size: 11.5dp;
	font-weight: bold;
	color: #9aa3b8;
	background-color: #ffffff10;
}
.item.have .item-qty { color: #5fe0b0; background-color: #2fcf9526; }
.item-name { color: #d3d9e8; font-size: 12.5dp; }

.step-list {
	flex: 1 1 auto;
	overflow-y: auto;
	display: flex;
	flex-direction: column;
	gap: 6dp;
	padding: 2dp;
}

.step {
	padding: 10dp 12dp;
	border-radius: 10dp;
	background-color: #ffffff07;
	border: 1dp #ffffff0e;
	border-left: 3dp #ffb02e88;
	transition: background-color border-color 0.2s cubic-out;
	animation: 0.35s cubic-out rise;
}
.step:hover { background-color: #ffffff0c; }
.step.done {
	border-left-color: #2fcf95;
	decorator: horizontal-gradient(#2fcf9512 #2fcf9500);
}
.step-top {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
}
.badge {
	padding: 2dp 8dp;
	border-radius: 8dp;
	font-size: 10.5dp;
	font-weight: bold;
	letter-spacing: 0.6dp;
	color: #ffd166;
	background-color: #ffb02e22;
}
.step.done .badge { color: #5fe0b0; background-color: #2fcf9526; }
.step-title { flex: 1; font-weight: bold; color: #f2f4fa; font-size: 13dp; }
.step-detail { margin-top: 4dp; color: #8d97ad; font-size: 12dp; }

.footer-note {
	flex: 0 0 auto;
	color: #7f889d;
	font-size: 11.5dp;
}

.actions {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	gap: 8dp;
}

.btn {
	display: inline-block;
	padding: 6dp 14dp;
	text-align: center;
	border-radius: 8dp;
	font-size: 12dp;
	font-weight: bold;
	color: #d3d9e8;
	background-color: #ffffff10;
	border: 1dp #ffffff14;
	transition: background-color color border-color 0.15s cubic-out;
}
.btn:hover { background-color: #ffffff20; color: #ffffff; }
.btn:active { background-color: #ffffff30; }
.btn.primary { color: #ffffff; background-color: #7a4fe0; border-color: #b896ff66; }
.btn.primary:hover { background-color: #9b6bff; }
.btn .ico { font-size: 11dp; }

/* talents toolbar */
.toolbar {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	flex: 0 0 auto;
}
.search {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 260dp;
	height: 30dp;
	padding: 0 10dp;
	border-radius: 9dp;
	background-color: #00000040;
	border: 1dp #ffffff1a;
	transition: border-color background-color 0.15s cubic-out;
}
.search:hover { border-color: #ffffff33; }
.search.active { border-color: #9b6bffaa; background-color: #9b6bff12; }
.search .ico { color: #7f889d; font-size: 12dp; margin-right: 8dp; }
.search input.text {
	flex: 1;
	padding: 0;
	border-width: 0;
	background-color: #00000000;
	height: 28dp; line-height: 28dp;
}
.search .hint {
	position: absolute;
	left: 31dp; top: 6dp;
	color: #646d82;
	pointer-events: none;
}
.search.filled .hint, .search.active .hint { display: none; }

.split {
	flex: 1 1 auto;
	display: flex;
	flex-direction: row;
	gap: 10dp;
	min-height: 0;
	overflow: hidden;
}

.tal-list {
	flex: 1.05;
	overflow-y: auto;
	padding: 4dp;
	border-radius: 12dp;
	background-color: #00000026;
	border: 1dp #ffffff10;
}

.tal-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 8dp 10dp;
	margin: 1dp 0;
	border-radius: 8dp;
	border-left: 3dp #00000000;
	transition: background-color border-color 0.15s cubic-out;
}
.tal-row:hover { background-color: #ffffff0b; }
.tal-row.sel {
	background-color: #9b6bff26;
	border-left-color: #9b6bff;
}
.tal-name { flex: 1; color: #e7eaf3; font-size: 12.5dp; white-space: nowrap; overflow: hidden; }
.tal-row.sel .tal-name { color: #ffffff; font-weight: bold; }
.chip {
	padding: 1dp 7dp;
	border-radius: 8dp;
	font-size: 10.5dp;
	font-weight: bold;
	color: #c4b0ff;
	background-color: #9b6bff22;
	white-space: nowrap;
}

.tal-detail {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 8dp;
	padding: 14dp;
	border-radius: 12dp;
	background-color: #ffffff07;
	border: 1dp #ffffff10;
	overflow-y: auto;
}
.tal-detail.empty-detail { align-items: center; justify-content: center; text-align: center; }
.detail-name { font-size: 16dp; font-weight: bold; color: #ffffff; }
.detail-meta {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6dp;
}
.meta {
	padding: 3dp 9dp;
	border-radius: 8dp;
	font-size: 11dp;
	font-weight: bold;
	color: #c9d1e3;
	background-color: #ffffff12;
}
.meta.accent { color: #d7c4ff; background-color: #9b6bff2e; }
.detail-key { color: #8d97ad; font-size: 11.5dp; }
.detail-desc { color: #d3d9e8; font-size: 13dp; line-height: 1.4; margin-top: 4dp; }

.empty-ico {
	width: 52dp; height: 52dp; line-height: 52dp;
	margin-bottom: 8dp;
	border-radius: 26dp;
	font-family: Icons; font-size: 18dp;
	color: #b896ff;
	decorator: vertical-gradient(#9b6bff33 #4c8dff11);
	text-align: center;
}
.empty-title { font-size: 14dp; font-weight: bold; color: #ffffff; }
.empty-sub { margin-top: 4dp; color: #8d97ad; font-size: 12dp; max-width: 220dp; }
